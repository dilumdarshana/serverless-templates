{
  "name": "serverless-template",
  "version": "1.0.0",
  "description": "AWS Serverless Framework TypeScript reference template - REST API, DynamoDB, SQS event-driven, S3, cron, custom authorizer",
  "main": "src/handler.ts",
  "author": "Dilum Darshana",
  "license": "MIT",
  "scripts": {
    "offline": "serverless offline start -r us-west-2 --noTimeout --stage local",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "cross-env LOCAL=true LAMBDA_REGION=eu-west-2 LAMBDA_STAGE=dev jest --config jest.config.js",
    "test:unit": "cross-env LOCAL=true LAMBDA_REGION=eu-west-2 LAMBDA_STAGE=dev jest --config jest.config.js --watchAll",
    "deploy:dev": "sls deploy --stage dev --verbose",
    "package": "sls package --verbose",
    "deploy:test": "sls testDeploymentBucket --stage test --verbose"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1104.0",
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/client-sqs": "^3.1104.0",
    "@aws-sdk/lib-dynamodb": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@hapi/boom": "^10.0.1",
    "joi": "^18.2.3",
    "lambda-api": "^1.4.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "serverless": "^4.40.0",
    "serverless-offline": "^14.7.4",
    "serverless-offline-ssm": "^6.2.0",
    "serverless-plugin-tracing": "^2.0.0",
    "serverless-prune-plugin": "^2.1.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
